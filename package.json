{
  "name": "pi-okf-wiki",
  "version": "0.4.1",
  "description": "Pi extension that implements the Open Knowledge Format (OKF) as a local knowledge base with /wiki-update and /wiki-query commands.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "okf",
    "knowledge-base",
    "wiki"
  ],
  "homepage": "https://github.com/Panzenbaby/pi-okf-wiki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Panzenbaby/pi-okf-wiki.git"
  },
  "bugs": {
    "url": "https://github.com/Panzenbaby/pi-okf-wiki/issues"
  },
  "author": "",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "html-to-text": "^10.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "unpdf": "^1.6.2",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "pi": ">=0.80.0"
  }
}
